CAPTAIN_PORT=4317
# Typed deterministic tasks need no model or API key.
# Set a locally installed model explicitly for optional Ollama planning.
CAPTAIN_OLLAMA_MODEL=
CAPTAIN_OLLAMA_VISION=false
# Remote planning is opt-in. Leave the API key empty for local operation.
CAPTAIN_VLM_BASE_URL=
CAPTAIN_VLM_API_KEY=
CAPTAIN_VLM_MODEL=
CAPTAIN_MAX_STEPS=12
